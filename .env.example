# Copy to .env for local runs. Never commit real values.
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080

# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Shared secret Cloud Scheduler sends as the X-Cron-Secret header
CRON_SECRET=

# Storage: "memory" (local) or "firestore" (set automatically when GOOGLE_CLOUD_PROJECT is present)
STORE_DRIVER=memory
GOOGLE_CLOUD_PROJECT=
# Optional: persist the memory store to a file during local development
DATA_FILE=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email (Gmail: smtp.gmail.com, port 465, an App Password). Leave SMTP_HOST empty for demo mode.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SaathiCare <your-address@gmail.com>

# Seed the DEMO42 / 246810 demo circle on startup
DEMO_SEED=true
